# 所有 VITE_ 变量都会公开到浏览器！这里只能放公开配置。
VITE_BASE_PATH=/nju-xianlin-food-map/
VITE_DATA_SOURCE=mock
VITE_API_URL=http://localhost:8787
VITE_MEDIA_BASE_URL=
# 仅影响原型提示；实际写保护由数据库维护开关执行
VITE_READ_ONLY=true
# 服务端配置，绝不可使用 VITE_ 前缀
PORT=8787
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://foodmap:change-me@localhost:5432/foodmap
# Docker 数据库密码需替换成长随机值
POSTGRES_PASSWORD=change-me
API_DATABASE_PASSWORD=change-me-too
PUBLIC_ORIGIN=http://localhost:8080
# 外部程序 pg_dump/pg_restore 使用 libpq 环境变量，推荐 PGSERVICE + .pgpass
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=foodmap
# PGUSER=foodmap
# PGPASSFILE=/absolute/path/to/private/pgpass
