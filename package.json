{
  "name": "nju-xianlin-food-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/osm/build-runtime.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src server scripts tests docs *.json *.ts *.md *.yml .github",
    "test": "tsx --test tests/*.test.ts",
    "test:db": "node --test tests/database.integration.mjs",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "data:export": "tsx scripts/export-catalog.ts",
    "api": "node --env-file-if-exists=.env server/index.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:backup": "node --env-file-if-exists=.env scripts/database.mjs backup",
    "db:restore": "node --env-file-if-exists=.env scripts/database.mjs restore",
    "db:verify": "node --env-file-if-exists=.env scripts/database.mjs verify",
    "db:maintenance": "node --env-file-if-exists=.env scripts/maintenance.mjs",
    "files:sync": "node scripts/storage.mjs",
    "files:verify": "node --env-file-if-exists=.env scripts/media-verify.mjs",
    "data:validate": "tsx scripts/validate-data.ts",
    "osm:fetch": "python scripts/osm/fetch.py",
    "osm:convert": "node scripts/osm/convert.mjs",
    "osm:align": "python scripts/osm/align-venues.py",
    "osm:build-campus": "node scripts/osm/build-campus.mjs",
    "osm:build-runtime": "node scripts/osm/build-runtime.mjs",
    "osm:fetch-dem": "python scripts/osm/fetch-dem.py",
    "osm:build-contours": "python scripts/osm/build-contours.py",
    "osm:build-relief": "python scripts/osm/build-green-relief.py",
    "osm:build-forest": "python scripts/osm/build-forest-texture.py",
    "osm:validate-forest": "python scripts/osm/validate-forest-texture.py",
    "osm:validate-relief": "python scripts/osm/validate-green-relief.py",
    "osm:validate-contours": "python scripts/osm/validate-contours.py",
    "osm:validate-campus": "python scripts/osm/validate-campus.py"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "osmtogeojson": "^3.0.0-beta.5",
    "prettier": "3.9.10",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12"
  }
}
